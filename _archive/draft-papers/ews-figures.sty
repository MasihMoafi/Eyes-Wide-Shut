% ews-figures.sty — the single visual system for every Eyes Wide Shut figure.
%
% Every figure in figures/ loads this and nothing else defines colour, type or
% panel geometry. A figure therefore cannot drift from the system; that drift is
% what made the earlier drafts inconsistent.
%
% Figures compile standalone with xelatex at exactly \ewswidth, which is TMLR's
% \textwidth. They are then included at natural size, so 8pt type inside a figure
% renders at exactly 8pt on the page.
\ProvidesPackage{ews-figures}[2026/07/29 Eyes Wide Shut figure system]

\RequirePackage{fontspec}
\RequirePackage{xcolor}
\RequirePackage[most]{tcolorbox}
\RequirePackage{fvextra}
\RequirePackage{tikz}
\RequirePackage{pgfplots}
\usetikzlibrary{arrows.meta,positioning,calc,fit,backgrounds}
\pgfplotsset{compat=1.18}

% ---------------------------------------------------------------- geometry ---
% TMLR \textwidth, measured from the compiled class. Do not change.
\newlength{\ewswidth}\setlength{\ewswidth}{469.755pt}

% ------------------------------------------------------------------ palette ---
% Muted and warm. Colour marks evidence; it never decorates.
% All hues are distinguishable in greyscale by lightness.
\definecolor{ewspaper}{HTML}{F7F6F2}  % warm off-white panel ground
\definecolor{ewsink}{HTML}{1A1A1A}    % body ink
\definecolor{ewsmute}{HTML}{6E6A63}   % secondary text
\definecolor{ewsrule}{HTML}{D8D4CC}   % hairline
\definecolor{ewshl}{HTML}{F2E9C4}     % highlighted token
\definecolor{ewsaccent}{HTML}{C4562E} % annotation / the crossed boundary
\definecolor{ewsblue}{HTML}{3B6EA5}   % structure, model side
\definecolor{ewsgreen}{HTML}{24543A}  % contained / refused
\definecolor{ewsslate}{HTML}{4E5A63}  % host side

% -------------------------------------------------------------------- type ---
\setmainfont{Inter}[
  UprightFont = *-Regular, BoldFont = *-SemiBold, ItalicFont = *-Italic,
  Scale = 1.0 ]
\newfontfamily\ewsmono{Noto Sans Mono}[Scale=1.0]
\newfontfamily\ewslabel{Inter}[UprightFont=*-SemiBold, Scale=1.0]

\newcommand{\ewscap}[1]{{\ewslabel\fontsize{7.4}{9}\selectfont\MakeUppercase{#1}}}
\newcommand{\ewsnote}[1]{{\fontsize{7.6}{9.6}\selectfont\color{ewsmute}#1}}

% ------------------------------------------------------------------- bands ---
% A, B, C band header: letter, title, then a hairline across the full width.
\newcommand{\ewsband}[2]{%
  \par\noindent
  {\ewslabel\fontsize{9}{11}\selectfont\color{ewsaccent}#1\hspace{0.5em}%
   \color{ewsink}#2}\par
  \vspace{2pt}\noindent{\color{ewsrule}\rule{\linewidth}{0.4pt}}\par
  \vspace{4pt}}

% ------------------------------------------------------------------ panels ---
\tcbset{
  ewsbox/.style={
    enhanced, sharp corners=all, arc=1.5pt,
    colback=ewspaper, colframe=ewsrule, boxrule=0.4pt,
    left=6pt, right=6pt, top=4pt, bottom=4pt,
    boxsep=0pt, before skip=2pt, after skip=2pt },
  ewscallout/.style={
    ewsbox, colback=ewspaper, colframe=ewsaccent, boxrule=0.6pt },
}

% ------------------------------------------------- verbatim trace excerpts ---
% Body text is 10pt; trace text is 8pt and vector. Nothing renders smaller.
%
% Highlighting inside verbatim uses commandchars with characters that never
% occur in the traces (asserted by build_excerpts.py before emission):
%   §hlt«...»   highlight a token span
%   §el«»       an elision marker
\newcommand{\hlt}[1]{\colorbox{ewshl}{\strut#1}}
\newcommand{\el}{{\color{ewsmute}\itshape[\,\dots\,]}}

\DefineVerbatimEnvironment{ewstrace}{Verbatim}{
  commandchars=\§\«\»,
  fontsize=\fontsize{8}{9.7}\selectfont,
  formatcom=\ewsmono\color{ewsink},
  breaklines=false, samepage=true }

% A diagram panel: the drawing is centred, the note beneath it is not.
% #1 = the note under the drawing
\newenvironment{ewsdiagram}{%
  \begin{tcolorbox}[ewsbox]\par\centering
}{\end{tcolorbox}}
\newcommand{\ewsdiagramnote}[1]{%
  \par\vspace{4pt}\noindent\raggedright\ewsnote{#1}\par}

% A labelled trace panel: role/channel strip above the verbatim body.
% #1 = channel label, #2 = right-hand annotation
\newenvironment{ewschannel}[2]{%
  \begin{tcolorbox}[ewsbox]%
  \noindent{\ewscap{#1}}\hfill{\ewsnote{#2}}\par
  \vspace{3pt}\noindent{\color{ewsrule}\rule{\linewidth}{0.3pt}}\par
  \vspace{3pt}%
}{\end{tcolorbox}}

% --------------------------------------------------------- figure wrapper ---
% Fixes every figure to exactly \ewswidth so nothing is ever scaled.
\newenvironment{ewsfigure}{%
  \begin{minipage}{\ewswidth}\color{ewsink}\fontsize{8.4}{10.6}\selectfont
}{\end{minipage}}

\endinput
